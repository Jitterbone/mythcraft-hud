<div class="animated-rolls-container {{style}}">
  <div class="animated-rolls-slot-container">
    {{#each dice}}
    <div class="slot-window" data-final="{{#if this.display}}{{this.display}}{{else}}{{this.result}}{{/if}}" data-faces="{{this.faces}}">
      <div class="slot-display js-slot-display">{{#if this.display}}{{this.display}}{{else}}{{this.result}}{{/if}}</div>
    </div>
    {{/each}}
    <div class="slot-bonus-pill bonus-pill {{bonusClass}}" aria-hidden="true"></div>
  </div>
  <div class="animated-rolls-total">
    <span class="formula">{{formula}}</span>
  </div>
  <div class="animated-rolls-details" aria-hidden="true">
    <div class="detail-row"><span class="detail-label">Raw dice</span><span class="detail-value">{{rawDiceFormula}}</span></div>
    <div class="detail-row"><span class="detail-label">Dice Results</span><span class="detail-value">{{rawDiceResults}}</span></div>
    {{#if modifiers.length}}
    <div class="detail-divider"></div>
    {{#each modifiers}}
    <div class="detail-row modifier-row">
      <span class="detail-label">{{this.label}}</span>
      <span class="detail-value {{this.cssClass}}">{{this.text}}</span>
    </div>
    {{/each}}
    {{/if}}
    {{#if bonus}}
    <div class="detail-divider"></div>
    <div class="detail-row total-mod-row">
      <span class="detail-label">Total Modifier</span>
      <span class="detail-value {{bonusClass}}">{{bonus.text}}</span>
    </div>
    <div class="detail-row final-total-row">
      <span class="detail-label">Final Total</span>
      <span class="detail-value highlight">{{total}}</span>
    </div>
    {{/if}}
  </div>
</div>