<div class="hud-list-container">
    <div style="padding: 10px; background: #1a1a1a; border-bottom: 1px solid #d3c4a3;">
        <h3 style="margin: 0 0 10px 0; color: #fdfaf3;">Active Conditions ({{effects.length}})</h3>
        {{#if effects.length}}
            {{#each effects}}
            <div style="padding: 8px; background: #222; margin: 5px 0; border-radius: 4px; border-left: 3px solid #e74c3c; display: flex; align-items: center; gap: 10px;">
                <img src="{{this.img}}" alt="{{this.name}}" style="width: 32px; height: 32px; border-radius: 4px;"/>
                <div style="flex: 1;">
                    <strong style="color: #fdfaf3;">{{this.name}}</strong>
                    <div style="font-size: 12px; color: #d3c4a3; margin-top: 4px;">{{{this.description}}}</div>
                </div>
                <button class="remove-condition-btn" data-effect-id="{{this.id}}" style="background: #e74c3c; border: none; color: white; padding: 6px 10px; cursor: pointer; border-radius: 4px;">Remove</button>
            </div>
            {{/each}}
        {{else}}
            <div style="color: #d3c4a3;">No Active Conditions</div>
        {{/if}}
    </div>
</div>
